# della-tridao overlay: train SWE-Rebench + TMax reaudit (evolution/data_rebench_tmax.json)
# with prompt_mean loss, eval TB 2.1 inline on its own GPU.
# 2 trainer (GPUs 0,3) + 2 DP1 generators (4,5) + 1 eval generator (7).
# GPUs 1,2 belong to another run and GPU 7 hosts another user's ~43 GiB server,
# so the eval engine is sized down with SWE_EVAL_GPU_MEMORY_LIMIT.
# Launch: set -a; . this; set +a; exec launch_9b.sh. Already-exported values win.

TRL_PROFILE=yichuan
# Release b8271b33: Rebench graders accept a repo whose HEAD descends from base
# (pack_to_dataset.patch_rebench_test_sh).
TRL_BASE=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/terminal-rl-rebench-tmax-v2
TRL_MODEL=/scratch/gpfs/TRIDAO/al9080/models/Qwen3.5-9B
TRL_VENV=/scratch/gpfs/TRIDAO/al9080/titan-rl
HF_HOME=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/cache/hf
TRITON_CACHE_DIR=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/cache/triton
TORCHINDUCTOR_CACHE_DIR=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/cache/inductor
FLASHINFER_WORKSPACE_BASE=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/cache/flashinfer
PYTHONFAULTHANDLER=1
TRL_CKPT_EXPORT=0
TRL_CKPT_MIRROR=0

RL_GPUS=0,3,4,5,7
RL_OBSERVE_REWARDS=0

WANDB_PROJECT=terminal-agent-rl
WANDB_NAME='rebench+tmax-reaudit 9b c350 2t2g1e promptmean tb21'

SWE_DP_SHARD=2
SWE_NUM_GENERATORS=2
SWE_GEN_DP=1
SWE_NUM_EVAL_GENERATORS=1
SWE_EVAL_GEN_DP=1
SWE_GPU_MEM_LIMIT=0.88
SWE_EVAL_GPU_MEMORY_LIMIT=0.6
SWE_EVAL_ROLLOUT_CONCURRENCY=48
SWE_NUM_EVAL_ROLLOUT_WORKERS=4

SWE_ROLLOUT_CONCURRENCY=350
SWE_NUM_ROLLOUT_WORKERS=8
SWE_GROUP_SIZE=12
SWE_NUM_GROUPS_PER_TRAIN_STEP=32
# SWE_MAX_ACTIVE_GROUPS / SWE_INITIAL_ACTIVE_GROUPS come from rltrain.env (160 / 64).
# 40 counted groups already finished and waiting for the trainer, so the first
# run sat at ~80 live rollouts behind stragglers instead of 350.
SWE_LOSS_AGG=prompt_mean
SWE_LR=3e-6
SWE_DROP_ZERO_STD=0
SWE_TRAIN_STEPS=400
SWE_DATA_HOT_RELOAD=0
SWE_EVOLUTION_SIGNALS=0
SWE_DP_FALLBACK_ROUTER=leastloaded
SWE_DP_STICKY_REBALANCE=0
SWE_ROLLOUT_RECORDS=1

SWE_HOLDOUT_N=0
SWE_TB2_VAL_DATA=/scratch/gpfs/TRIDAO/al9080/terminal-rl/data/evalsets/tb2_1_tmux_f1640f428d48.jsonl
SWE_TB2_VAL_K=5
SWE_TB2_VAL_TEMPERATURE=1.0
SWE_TB2_VAL_TOP_P=1.0
SWE_VAL_SAMPLES=89
SWE_VAL_INTERVAL=20

TMAX_CONTEXT_WARN_FRAC=0.5
TMAX_CONTEXT_NOTICE_STYLE=della
TMAX_SHADOW_GRADE_UNSUBMITTED=1

TT_DAYTONA_CREATE_CONCURRENCY=32
TT_DAYTONA_LABEL=titan_rebench_tmax_c350
# A TB 2.1 eval sandbox can live 7200 s agent floor + verifier + boot, past 300 min.
TT_DAYTONA_TTL_MIN=480

VLLM_ALLREDUCE_USE_FLASHINFER=0
VLLM_USE_FLASHINFER_SAMPLER=0
