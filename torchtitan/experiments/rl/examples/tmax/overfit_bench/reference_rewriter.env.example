# Settings of the reference rewriter as it ran on the raman single-seed job
# (raman-root-v2/evolution/loop.env), paths and credentials left to the runner.
SWE_RETUNE_AGENT=codex
SYNTH_MODEL=gpt-5.6-sol
SYNTH_EFFORT=high
EVOLVE_CODEX_ACCOUNT_HOME=$HOME/.codex
SWE_EVOLVE_SIMPLIFY=1
SWE_SIMPLIFY_HINT=vague
EVOLVE_SPEC_REPAIR=1
EVOLVE_REWRITE_BUDGET_SEC=10800
TT_DAYTONA_CPU=1
TT_DAYTONA_MEM_GB=2
TT_DAYTONA_DISK_GB=2
TT_DAYTONA_EPHEMERAL=1
TT_DAYTONA_AUTO_DELETE_MIN=15
# Credentials: Daytona for the rewrite sandboxes, OpenAI for the loop's own
# model calls (SYNTH_ENV_FILE may name a file that exports OPENAI_API_KEY).
DAYTONA_API_KEY=
SYNTH_ENV_FILE=
# The job's bin/ (codex, codex-code-mode-host, jq) must be on PATH.
PATH=/path/to/bin:$PATH
