# The overfit bench's fixed training recipe: every job, every rewriter, the same.
# Hardware placement (RL_GPUS, SWE_DP_SHARD, SWE_GEN_DP, SWE_NUM_GENERATORS,
# SWE_GPU_MEM_LIMIT, SWE_AC, SWE_LOSS_CHUNKS, checkpoint keep/export) is the
# runner's and lives in its own env file; start_training.sh reads both, this
# file first, and runbook/rltrain.env fills whatever neither sets.
SWE_GROUP_SIZE=12
SWE_NUM_GROUPS_PER_TRAIN_STEP=1
# Eight groups in flight. A group waits behind up to seven others before it is
# trained, so the staleness cap is 8: at the default 4 a slow group -- the long
# attempts, which are the ones that matter on a hard task -- would be dropped.
SWE_INITIAL_ACTIVE_GROUPS=8
SWE_MAX_ACTIVE_GROUPS=8
SWE_OFFPOLICY_STEPS=8
# Passes the work-conserving check with 8 active groups of 12: two workers of
# 36 rollouts each need 36 // 12 + 1 = 4 groups apiece. 72 sandboxes at once.
SWE_NUM_ROLLOUT_WORKERS=2
SWE_ROLLOUT_CONCURRENCY=72
SWE_LR=3e-6
SWE_TRAIN_STEPS=200
# Training draws from the scheduler's version pool (README.md, "Interface").
SWE_BENCH_SCHEDULER=1
# A training attempt is 60 turns and nothing else: no wall clock, no
# SWE_AGENT_TIMEOUT_FLOOR_SEC, whatever the task declares. The readout keeps
# its own budget (README.md, "What the bench fixes").
SWE_BENCH_MAX_TURNS=60
TMAX_AGENT=terminus
# Every sandbox -- training, readout and a separate verifier -- gets 4 vCPU.
# Memory and disk stay the row's (clamped to Daytona's 8 GiB / 10 GiB caps).
SWE_BENCH_SANDBOX_CPU=4
TMAX_CONTEXT_NOTICE_STYLE=v2
TMAX_CONTEXT_WARN_FRAC=0.7
# Readout: the original task alone, 16 attempts every 5 steps.
SWE_VAL_SAMPLES=1
SWE_TB2_VAL_K=16
SWE_TB2_VAL_TEMPERATURE=1.0
SWE_TB2_VAL_TOP_P=1.0
SWE_VAL_INTERVAL=5
SWE_VAL_ASYNC=1
SWE_CKPT_INTERVAL=5
# The pool, not the dataset, follows the mix: off so nothing else reads live.jsonl.
SWE_DATA_HOT_RELOAD=0
SWE_ROLLOUT_RECORDS=1
SWE_EVOLUTION_SIGNALS=1
